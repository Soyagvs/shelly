$NAMES = ["Ana", "Luis", "Mora"]
$numbers = [1, 3, 5, 8]

for $name in $NAMES
    shellout "Hello $name"
end

for $number in $numbers[>3]
    shellout "Filtered number $number"
end

if $numbers[>10]
    shellout "This will not print"
else
    shellout "No numbers above 10"
end

shellout "Last name was $name"
